<Window x:Class="ToDoAppVSWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoAppVSWPF"
        mc:Ignorable="d"
        Title="ToDo Application" Height="913" Width="1221">
    <Grid Margin="0,0,10,74" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="-0.113"/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>
        
        <!-- Sets boundrys for grid -->
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="109*"/>
            <ColumnDefinition Width="209*"/>
            <ColumnDefinition Width="327*"/>
            <ColumnDefinition Width="340*"/>
        </Grid.ColumnDefinitions>

        <!-- 
        Each Item in the GUI has a name starting with the section it belongs to 
                      followed by the name of the item ie (Title)
                       with the type at the end in short format 
        -->

        <!-- ToDoItem Section -->
        <StackPanel HorizontalAlignment="Left" Margin="7,3,0,0" Orientation="Vertical" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <Label x:Name="ToDoItemlbl" Content="ToDo Item"/>
            <Label x:Name="ToDoItemTitlelbl" Content="Title:"/>
            <TextBox x:Name="ToDoItemTitletbx" TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <Label x:Name="ToDoItemIDlbl" Content="ID:"/>
            <TextBox x:Name="ToDoItemIDtbx" TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <Label x:Name="ToDoItemDesclbl" Content="Description:"/>
            <TextBox x:Name="ToDoItemDesctbx" Height="134" Width="122"/>
            <Label x:Name="ToDoItemDueDatelbl" Content="Due Date:"/>
            <TextBox x:Name="ToDoItemDueDatetbx" TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <Label x:Name="ToDoItemLabellbl" Content="Label/s"/>
            <TextBox x:Name="ToDoItemLabeltbx" TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <Label x:Name="ToDoItemPrioritylbl" Content="Priority"/>
            <ComboBox x:Name="ToDoItemPrioritycbx" Width="120"/>
            <Label x:Name="ToDoItemCategorylbl" Content="Category:"/>
            <ComboBox x:Name="ToDoItemCategorycbx" Width="120"/>
            <Button x:Name="ToDoItemAddbtn" Content="Add ToDo Item" Width="120" Click="ToDoItemAddbtn_Click"/>
        </StackPanel>

        <!-- TaskItem Section -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Left" Margin="15,5,0,0" Orientation="Vertical" VerticalAlignment="Top">
            <Label x:Name="TaskItemlbl" Content="Task Item"/>
            <Label x:Name="TaskItemTitlelbl" Content="Title:"/>
            <TextBox x:Name="TaskItemTitletbx" TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <Label x:Name="TaskItemIDlbl" Content="ID:"/>
            <TextBox x:Name="TaskItemIDtbx" TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <Label x:Name="TaskItemDesclbl" Content="Description:"/>
            <TextBox x:Name="TaskItemDesctbx" Height="132" Width="120"/>
            <Label x:Name="TaskItemCategorylbl" Content="Category:"/>
            <ComboBox x:Name="TaskItemCategorycbx" Width="120"/>
            <Button x:Name="TaskItembtn" Content="Add Task Item" Width="120" Click="TaskItembtn_Click"/>
        </StackPanel>

        <!-- Category Section -->
        <StackPanel Grid.Column="1" Margin="159,1,368,0" Orientation="Vertical" VerticalAlignment="Top" Height="137" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.034"/>
                    <TranslateTransform/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <Label x:Name="Categorylbl" Content="Category"/>
            <Label x:Name="CategoryTitlelbl" Content="Title:"/>
            <TextBox x:Name="CategoryTitletbx" TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <Label x:Name="CategoryIDlbl" Content="ID:"/>
            <TextBox x:Name="CategoryIDtbx" TextWrapping="Wrap" Text="TextBox" Width="120"/>
            <Button x:Name="CategoryAddbtn" Content="Add Category" Width="120" Click="CategoryAddbtn_Click"/>
        </StackPanel>

        <!-- File Control Section -->
        <StackPanel Grid.Column="3" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="47,452,0,0">
            <Button x:Name="Savebtn" Content="Save" Width="120" Click="Savebtn_Click"/>
            <Button x:Name="Loadbtn" Content="Load" Width="120" Click="Loadbtn_Click"/>
        </StackPanel>

        <!-- List Section -->
        <ListView x:Name="Itemsltv"  Margin="9,489,5,-64" Grid.ColumnSpan="4">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Category" Width="200" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Task" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Task}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Description" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Labels" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Labels}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Priority (High-Medium-Low)" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Name="tbxCool" Text="{Binding Priority}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Due Date" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DueDate}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        
        <!-- Remove/Completed Section -->
        <StackPanel HorizontalAlignment="Left" Margin="116,331,0,0" Orientation="Horizontal" VerticalAlignment="Top" Grid.Column="3" Height="102" Width="479">
            <Button x:Name="Completedbtn" Content="Completed" Width="120" Height="100" Click="Completedbtn_Click"/>
            <Button x:Name="Remove" Content="Remove" Width="120" Height="100" Click="Remove_Click"/>
        </StackPanel>

        <MediaElement HorizontalAlignment="Left" Height="100" Margin="-81,-41,0,0" VerticalAlignment="Top" Width="100"/>

    </Grid>
</Window>
